VITE_API_URL=
# Delai max par requete (ms). Defaut 90000. Utile si backend en veille (cold start).
# VITE_API_TIMEOUT_MS=90000
VITE_SOCKET_URL=
# En production sur https://yoonwi-app.vercel.app, laissez VITE_API_URL vide pour utiliser les rewrites Vercel /api.
# VITE_SOCKET_URL peut rester vide: l'app utilisera Render pour le temps reel.
VITE_FALLBACK_BACKEND_URL=https://yoon-wi.onrender.com
VITE_GOOGLE_MAPS_API_KEY=votre_cle_api_google_maps
VITE_MAPBOX_TOKEN=votre_token_mapbox
VITE_MAPBOX_STYLE=mapbox/navigation-day-v1
